/* Starport Dictionary —— 冷纸工程手册
   2026-11-22 重做：干掉紫色霓虹/大圆角/卡片套卡片。
   规则：圆角只用 2px；不用阴影、渐变、发光；层级靠字号、字重、空间和一条细线。
   颜色 12 个，字号 7 档——改这里要与 theme.py 同步。 */

QWidget {
    background-color: transparent;
    color: #E9E7E2;
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
    font-size: 13px;
}

QMainWindow {
    background-color: #0B0B0C;
}

#Root, #Home {
    background-color: #0B0B0C;
}

QStackedWidget {
    background-color: transparent;
}

/* ——— 等宽标签：全站唯一的"工程感"来源 ——— */
#Label {
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 11px;
    color: #6E6A64;
    letter-spacing: 1.4px;
}

#Mono {
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 12px;
    color: #A6A29A;
}

#MonoId {
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 12px;
    color: #6E6A64;
}

/* ——— 品牌行 ——— */
#Brand {
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 11px;
    color: #A6A29A;
    letter-spacing: 3px;
}

#BrandHero {
    font-size: 32px;
    font-weight: 600;
    color: #E9E7E2;
}

#Tagline {
    font-size: 13px;
    color: #A6A29A;
}

/* ——— 搜索框：页面唯一的大型元素 ——— */
#SearchInput {
    background-color: #111113;
    border: 1px solid #3C3C42;
    border-radius: 2px;
    padding: 14px 16px;
    font-size: 20px;
    color: #E9E7E2;
    selection-background-color: #7E6A45;
}
#SearchInput:focus {
    border: 1px solid #C8A464;
}
#SearchInput:hover {
    border: 1px solid #4A4A52;
}

#SearchSmall {
    background-color: #111113;
    border: 1px solid #26262A;
    border-radius: 2px;
    padding: 7px 12px;
    font-size: 13px;
    color: #E9E7E2;
    selection-background-color: #7E6A45;
}
#SearchSmall:focus {
    border: 1px solid #C8A464;
}

/* ——— 刻度尺：搜索框下面那条，呼应"仪表盘" ——— */
#Ruler {
    background-color: transparent;
    border: none;
    border-top: 1px solid #26262A;
}

/* ——— 文字层级 ——— */
#Hero {
    font-size: 32px;
    font-weight: 600;
    color: #E9E7E2;
}

#CardTitle {
    font-size: 19px;
    font-weight: 600;
    color: #E9E7E2;
}

#DetailTitle {
    font-size: 24px;
    font-weight: 600;
    color: #E9E7E2;
}

#RowTitle {
    font-size: 15px;
    font-weight: 600;
    color: #E9E7E2;
}

#Body {
    font-size: 13px;
    color: #C9C6BF;
}

#Muted {
    font-size: 12px;
    color: #A6A29A;
}

#Hint {
    font-size: 11px;
    color: #6E6A64;
    font-family: "Cascadia Mono", "Consolas", monospace;
}

#SectionTitle {
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 11px;
    color: #6E6A64;
    letter-spacing: 1.4px;
}

/* ——— 层级标记：不再是彩色圆角徽章，而是等宽小字 + 一条色线 ——— */
#Badge {
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 11px;
    padding: 1px 0px;
    border: none;
    background: transparent;
    letter-spacing: 1px;
}
#Badge[level="builtin"] {
    color: #C8A464;
}
#Badge[level="stdlib"] {
    color: #8FAE63;
}
#Badge[level="thirdparty"] {
    color: #B8634F;
}
#Badge[level="unknown"] {
    color: #6E6A64;
}

/* ——— 行（候选 / 结果）：细线分隔，不是卡片 ——— */
#Candidate {
    background-color: transparent;
    border: none;
    border-bottom: 1px solid #26262A;
    border-radius: 0px;
}
#Candidate:hover {
    background-color: #111113;
}
#Candidate[selected="true"] {
    background-color: #151517;
    border-left: 2px solid #C8A464;
}

/* ——— 最佳匹配：左侧一条黄铜竖线，无框 ——— */
#BestCard {
    background-color: #111113;
    border: none;
    border-left: 2px solid #C8A464;
    border-radius: 0px;
}
#BestCard:hover {
    background-color: #151517;
}

/* ——— 通用面板：只画一条上边线 ——— */
#Panel {
    background-color: transparent;
    border: none;
    border-top: 1px solid #26262A;
    border-radius: 0px;
}

/* ——— import 面板 ——— */
#ImportPanel {
    background-color: #0E0E10;
    border: none;
    border-left: 2px solid #3C3C42;
    border-radius: 0px;
}
#ImportOk {
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 12px;
    color: #8FAE63;
    letter-spacing: 0.6px;
}
#ImportCode {
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 13px;
    color: #E9E7E2;
    background: transparent;
}

/* ——— 按钮：文字优先，边框克制 ——— */
QPushButton {
    background-color: transparent;
    border: 1px solid #3C3C42;
    border-radius: 2px;
    padding: 7px 14px;
    color: #E9E7E2;
    font-size: 13px;
}
QPushButton:hover {
    border: 1px solid #C8A464;
    color: #E9E7E2;
}
QPushButton:pressed {
    background-color: #151517;
}
QPushButton:focus {
    border: 1px solid #C8A464;
}

#Primary {
    background-color: #C8A464;
    border: 1px solid #C8A464;
    color: #0B0B0C;
    font-weight: 600;
}
#Primary:hover {
    background-color: #D7B478;
    border-color: #D7B478;
    color: #0B0B0C;
}

#Ghost {
    background: transparent;
    border: none;
    color: #A6A29A;
    padding: 4px 0px;
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 12px;
}
#Ghost:hover {
    color: #C8A464;
    border: none;
}

/* 示例 / 最近：文字行，不是胶囊 */
#ExampleRow {
    text-align: left;
    background: transparent;
    border: none;
    border-bottom: 1px solid #1B1B1E;
    border-radius: 0px;
    text-align: left;
    padding: 9px 4px;
    color: #C9C6BF;
    font-size: 13px;
}
#ExampleRow:hover {
    color: #E9E7E2;
    border-bottom: 1px solid #3C3C42;
    background-color: #111113;
}

#Chip {
    text-align: left;
    background: transparent;
    border: none;
    border-bottom: 1px solid #1B1B1E;
    border-radius: 0px;
    padding: 4px 0px;
    color: #A6A29A;
    font-size: 12px;
}
#Chip:hover {
    color: #C8A464;
    border-bottom: 1px solid #7E6A45;
}
#Chip {
    padding: 5px 0px;
}

#CopyBtn {
    background: transparent;
    border: none;
    border-left: 1px solid #26262A;
    border-radius: 0px;
    padding: 2px 10px;
    color: #A6A29A;
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 11px;
}
#CopyBtn:hover {
    color: #C8A464;
}

#FeedbackBtn {
    background: transparent;
    border: none;
    border-bottom: 1px solid transparent;
    border-radius: 0px;
    padding: 5px 2px;
    color: #A6A29A;
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 11px;
    letter-spacing: 1px;
}
#FeedbackBtn[verdict="ok"]:hover {
    color: #8FAE63;
    border-bottom: 1px solid #8FAE63;
}
#FeedbackBtn[verdict="bad"]:hover {
    color: #B8634F;
    border-bottom: 1px solid #B8634F;
}

/* ——— 代码块：上下细线，不要框 ——— */
#CodeFrame {
    background-color: #0E0E10;
    border: none;
    border-top: 1px solid #26262A;
    border-bottom: 1px solid #26262A;
    border-radius: 0px;
}
#CodeEdit {
    background-color: #0E0E10;
    border: none;
    color: #D8D5CE;
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 13px;
    selection-background-color: #3C3C42;
}

/* ——— 参数表：只有横线 ——— */
#ArgsHeader {
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 11px;
    color: #6E6A64;
    letter-spacing: 1px;
    border-bottom: 1px solid #26262A;
    padding-bottom: 6px;
}

/* ——— 滚动条 ——— */
QScrollArea {
    border: none;
}
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background: #3C3C42;
    border-radius: 0px;
    min-height: 28px;
}
QScrollBar::handle:vertical:hover {
    background: #C8A464;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

#Status {
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 11px;
    color: #6E6A64;
    letter-spacing: 0.5px;
}

QToolTip {
    background-color: #111113;
    color: #E9E7E2;
    border: 1px solid #3C3C42;
    padding: 5px 8px;
    font-size: 12px;
}
